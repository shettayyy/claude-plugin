{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [
      "Bash(git commit *)"
    ]
  },
  "obsoleteDeny": [
    "Write(**/.env)",
    "Write(**/.env.*)",
    "Bash(**/.env)",
    "Bash(**/.env.*)"
  ],
  "extraKnownMarketplaces": {
    "claude-plugin": {
      "source": {
        "source": "github",
        "repo": "shettayyy/claude-plugin"
      },
      "autoUpdate": true
    }
  }
}
